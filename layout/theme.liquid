<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }}</title>
    <link rel="icon" type="image/x-icon" href="/img/favicon-100w.ico" />
    <link rel="canonical" href="{{ site_url }}/{% if page != 'index' %}{{ page }}{% endif %}" />
    <meta name="theme-color" content="#f3e7c6" />
    {% if description %}<meta name="description" content="{{ description }}" />
    <meta property="og:description" content="{{ description }}" />
    {% endif %}<meta property="og:site_name" content="{{ business.name }}" />
    <meta property="og:title" content="{{ title }}" />
    <meta property="og:url" content="{{ site_url }}/{% if page != 'index' %}{{ page }}{% endif %}" />
    <meta property="og:type" content="website" />
    {% if og_image %}<meta property="og:image" content="{{ site_url }}{{ og_image }}" />
    <meta property="og:image:width" content="{{ og_image_width }}" />
    <meta property="og:image:height" content="{{ og_image_height }}" />
    <meta name="twitter:card" content="summary_large_image" />
    {% else %}<meta name="twitter:card" content="summary" />
    {% endif %}{% if noindex %}<meta name="robots" content="noindex" />
    {% endif %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"Restaurant","name":{% include 'json_string', value: business.name %},"url":"{{ site_url }}",{% if business.description != "" %}"description":{% include 'json_string', value: business.description %},{% endif %}"image":"{{ site_url }}/img/nice-dream-logo-og.png",{% if business.phone != "" %}"telephone":{% include 'json_string', value: business.phone %},{% endif %}{% if business.cuisine != "" %}"servesCuisine":{% include 'json_string', value: business.cuisine %},{% endif %}{% if business.price_range != "" %}"priceRange":{% include 'json_string', value: business.price_range %},{% endif %}"acceptsReservations":"{{ site_url }}/reservations","address":{"@type":"PostalAddress","streetAddress":{% include 'json_string', value: business.street_address %},"addressLocality":{% include 'json_string', value: business.locality %},"addressRegion":{% include 'json_string', value: business.region %},"postalCode":{% include 'json_string', value: business.postal_code %},"addressCountry":{% include 'json_string', value: business.country %}},"openingHours":[{% assign hours_separator = "" %}{% for hours in business.hours %}{% if hours.opens != "" %}{{ hours_separator }}"{{ hours.days }} {{ hours.opens }}-{{ hours.closes }}"{% assign hours_separator = "," %}{% endif %}{% endfor %}]}</script>
    <link rel="preload" href="/fonts/perrrot.otf" as="font" type="font/otf" crossorigin />
    <link rel="stylesheet" href="/css/site.css" />
    {% if stylesheet %}<link rel="stylesheet" href="{{ stylesheet }}" />
    {% endif %}
  </head>

  <body data-light="{% if light %}{{ light }}{% else %}golden{% endif %}"{% if page != 'index' %} data-compact{% endif %}>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="sky" aria-hidden="true">
      <div class="sky__light sky__light--morning"></div>
      <div class="sky__light sky__light--midday"></div>
      <div class="sky__light sky__light--golden"></div>
      <div class="sky__light sky__light--dusk"></div>
      <div class="sky__light sky__light--night"></div>
      <div class="sky__sun"></div>
    </div>

    <header class="masthead">
      {% if page == 'index' %}<h1 class="masthead__title"><a class="wordmark" href="/" aria-label="{{ business.name }}">NiCE DREAM</a></h1>
      {% else %}<a class="wordmark" href="/" aria-label="{{ business.name }}, home">NiCE DREAM</a>
      {% endif %}<nav class="masthead__nav" aria-label="Main">
        <ul role="list">
          <li><a href="/#visit">Visit</a></li>
          {% if events.size > 0 %}<li><a href="/#events">Events</a></li>
          {% endif %}<li><a href="/reservations"{% if page == 'reservations' %} aria-current="page"{% endif %}>Reservations</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
{{ page_content }}
    </main>

    <footer class="site-footer">
      <p class="site-footer__mark" aria-hidden="true">NiCE DREAM</p>
      <address class="site-footer__address">
        {{ business.street_address }}, {{ business.locality }}, {{ business.region }} {{ business.postal_code }}
        {% if business.phone != "" %}<br /><a href="tel:{{ business.phone | remove: ' ' | remove: '-' }}">{{ business.phone | remove: '+1 ' }}</a>{% endif %}
      </address>
      <ul class="site-footer__links" role="list">
        {% for link in business.links %}<li><a href="{{ link.url }}" rel="noopener">{{ link.label }}</a></li>
        {% endfor %}
      </ul>
      <p class="site-footer__fine">&copy; {{ "now" | date: "%Y" }} {{ business.name }}</p>
    </footer>

    <canvas class="clouds" aria-hidden="true"></canvas>
    <script defer src="/js/site.js"></script>
    <script defer src="/js/clouds.js"></script>
  </body>
</html>
