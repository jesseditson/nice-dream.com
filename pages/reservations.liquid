{%
  layout 'theme'
  , title: 'Reservations — Nice Dream'
  , page: 'reservations'
  , collection_id: '6a1e4d804c523c68c922bfed'
  , stylesheet: '/css/reservations.css'
%}

<article class="page-content">
  <section class="page-region">
    <section data-theme="" class="page-section page-section--medium">
      <div class="page-section__border">
        <div class="page-section__background"></div>
      </div>
      <div class="page-section__wrapper" style="">
        <div class="page-section__content">
          <div class="grid-wrapper">
            <div class="grid reservation-grid">
              <div class="reservation-grid__form">
                <div class="block code-block">
                  <div class="block__content">
                    <div>
                      <div id="nd-reservation-form">
                        <!-- ── FORM VIEW ──────────────────────────────────────────────── -->
                        <div id="nd-form-view">
                          <div class="nd-sheet">
                            <header class="nd-header">
                              <img class="nd-hero-dog" src="/img/nd-hero-dog.png" alt="Nice Dream dachshund holding a fork and spoon" />
                              <img class="nd-wordmark" src="/img/nd-wordmark.png" alt="Nice Dream" />
                              <h1 class="nd-title">Dinner Reservations</h1>
                            </header>

                            <svg class="nd-wave" viewBox="0 0 560 9" preserveAspectRatio="none" fill="none" aria-hidden="true">
                              <path d="M0 5 Q14 0 28 5 T56 5 T84 5 T112 5 T140 5 T168 5 T196 5 T224 5 T252 5 T280 5 T308 5 T336 5 T364 5 T392 5 T420 5 T448 5 T476 5 T504 5 T532 5 T560 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                            </svg>

                            <p class="nd-blurb">
                              {{ dinner.blurb }}
                            </p>
                            <p class="nd-blurb-note">
                              Your reservation isn't confirmed until we reach out — expect to hear from us within 24
                              hours.
                            </p>

                            {% if dinner.sample_menu %}<a class="nd-menu-link" href="{{ dunner.sample_menu.url }}" target="_blank" rel="noopener">
                              <span class="nd-menu-link-text">Peek at the sample menu</span>
                              <svg class="nd-menu-link-arrow" viewBox="0 0 20 12" fill="none" aria-hidden="true">
                                <path d="M1 6 H17 M12 1.5 L17.5 6 L12 10.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                              </svg>
                            </a>
                            {% endif %}
                            <p class="nd-blurb-note" style="margin-top:12px;">
                              Please note that we have limited vegan and vegetarian options.
                            </p>

                            <svg class="nd-wave" viewBox="0 0 560 9" preserveAspectRatio="none" fill="none" aria-hidden="true">
                              <path d="M0 5 Q14 0 28 5 T56 5 T84 5 T112 5 T140 5 T168 5 T196 5 T224 5 T252 5 T280 5 T308 5 T336 5 T364 5 T392 5 T420 5 T448 5 T476 5 T504 5 T532 5 T560 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                            </svg>

                            <form id="nd-gform" action="https://docs.google.com/forms/d/e/1FAIpQLSchcYHiVAHnNARJgtRk0WhL7K8-BvEp77tvW_gExAjUfM10cg/formResponse" method="POST">
                              <!-- 1. Name -->
                              <div class="nd-field">
                                <label class="nd-label" for="nd-name">Your name</label>
                                <input class="nd-input" type="text" id="nd-name" name="entry.770264563" placeholder="First and last name" required autocomplete="name" />
                              </div>

                              <div class="nd-field">
                                <label class="nd-label" for="nd-date">Which night?</label>
                                <input class="nd-input" type="date" id="nd-date" name="entry.1485072520" min="2026-06-23" required />
                                <p class="nd-field-note">
                                  Reservations are for Thursday, Friday & Saturday. No dinner service on Sundays.
                                </p>
                                <p class="nd-field-error" id="nd-date-error" role="alert">
                                  Sorry — we serve dinner Thursday, Friday &amp; Saturday only. Please pick one of those
                                  nights.
                                </p>
                              </div>

                              <!-- 3. Preferred time -->
                              <div class="nd-field">
                                <label class="nd-label" for="nd-time">Preferred time</label>
                                <select class="nd-select" id="nd-time" name="entry.292497760" required>
                                  <option value="" disabled selected>— select a time —</option>
                                  <option value="6:00 PM">6:00 PM</option>
                                  <option value="6:30 PM">6:30 PM</option>
                                  <option value="7:00 PM">7:00 PM</option>
                                  <option value="7:30 PM">7:30 PM</option>
                                  <option value="8:00 PM">8:00 PM</option>
                                </select>
                              </div>

                              <!-- 4. Party size -->
                              <div class="nd-field">
                                <label class="nd-label" for="nd-party">Party size</label>
                                <select class="nd-select" id="nd-party" name="entry.561670517" required>
                                  <option value="" disabled selected>— select party size —</option>
                                  <option value="1">1</option>
                                  <option value="2">2</option>
                                  <option value="3">3</option>
                                  <option value="4">4</option>
                                  <option value="5">5</option>
                                  <option value="6">6</option>
                                  <option value="7">7</option>
                                  <option value="8">8</option>
                                </select>
                              </div>

                              <!-- 5. Contact preference -->
                              <!--
                                Pure-CSS toggle: radios are direct children so the :checked ~ rules
                                can reveal the matching field with NO JavaScript.
                              -->
                              <div class="nd-field nd-contact-group">
                                <label class="nd-label">How should we reach you?</label>

                                <input class="nd-contact-radio" type="radio" name="entry.207621246" id="nd-pref-email" value="Email" required />
                                <input class="nd-contact-radio" type="radio" name="entry.207621246" id="nd-pref-sms" value="Text (SMS)" />
                                <label class="nd-toggle-pill nd-pill-a" for="nd-pref-email">Email</label
                                ><label class="nd-toggle-pill nd-pill-b" for="nd-pref-sms">Text (SMS)</label>

                                <!-- Email field -->
                                <div class="nd-contact-field" id="nd-email-field">
                                  <label class="nd-label" for="nd-email" style="margin-top:0;">Email address</label>
                                  <input class="nd-input" type="email" id="nd-email" name="entry.744037489" placeholder="you@example.com" autocomplete="email" />
                                </div>

                                <!-- Phone field -->
                                <div class="nd-contact-field" id="nd-phone-field">
                                  <label class="nd-label" for="nd-phone" style="margin-top:0;">Mobile number</label>
                                  <input class="nd-input" type="tel" id="nd-phone" name="entry.1144138777" placeholder="(   )   -    " autocomplete="tel" disabled />
                                </div>
                              </div>

                              <!-- 6. Notes -->
                              <div class="nd-field">
                                <label class="nd-label" for="nd-notes">
                                  Anything we should know?
                                  <span class="nd-optional">optional</span>
                                </label>
                                <textarea class="nd-textarea" id="nd-notes" name="entry.1999442507" placeholder="Allergies, special occasions, or other requests"></textarea>
                              </div>

                              <!-- 7. Newsletter -->
                              <div class="nd-field">
                                <label class="nd-newsletter-label">
                                  <input type="checkbox" id="nd-newsletter" name="entry.1906633097" value="Yes! I'd love to receive the newsletter!" />
                                  <span class="nd-newsletter-text">
                                    Sign me up for updates from Nice Dream &amp; Sugar Water
                                  </span>
                                </label>
                              </div>

                              <!-- Submit -->
                              <button class="nd-submit" type="submit">Request a table</button>
                              <p class="nd-error" id="nd-error">
                                Something went wrong &mdash; please email us directly at
                                <a class="nd-email" data-u="hello" data-d="nice-dream.com" href="#">hello<span>&#64;</span>nice-dream.com</a
                                >.
                              </p>
                            </form>
                          </div>
                          <!-- /nd-sheet -->

                          <p class="nd-footmark">Nice Dream · Sugar Water</p>
                        </div>
                        <!-- /nd-form-view -->

                        <!-- ── CONFIRMATION VIEW ──────────────────────────────────────── -->
                        <div id="nd-confirmation">
                          <div class="nd-sheet">
                            <img class="nd-confirm-dog" src="/img/nd-confirm-dog.png" alt="A dachshund curled up asleep" />
                            <h2 class="nd-confirm-title">
                              We got<br>
                              your request.
                            </h2>

                            <svg class="nd-wave" viewBox="0 0 560 9" preserveAspectRatio="none" fill="none" aria-hidden="true">
                              <path d="M0 5 Q14 0 28 5 T56 5 T84 5 T112 5 T140 5 T168 5 T196 5 T224 5 T252 5 T280 5 T308 5 T336 5 T364 5 T392 5 T420 5 T448 5 T476 5 T504 5 T532 5 T560 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                            </svg>

                            <p class="nd-confirm-body">
                              Thank you for reaching out, <strong id="nd-confirm-name"></strong>. We'll confirm your
                              reservation within <strong>24 hours</strong>.
                            </p>
                            <p class="nd-confirm-body">
                              Please note: <strong>your reservation is not finalized until you hear from us.</strong>
                              We'll reach out via the contact information you provided.
                            </p>
                            <p class="nd-confirm-note">
                              Questions in the meantime? Email us at
                              <a class="nd-email" data-u="hello" data-d="nice-dream.com" href="#">hello<span>&#64;</span>nice-dream.com</a
                              >.
                            </p>
                          </div>
                          <p class="nd-footmark">Sweet dreams · See you soon</p>
                        </div>
                        <!-- /nd-confirmation -->
                      </div>
                      <!-- /nd-reservation-form -->

                      <script src="/js/reservations.js"></script>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </section>
</article>
