{%
  layout 'theme'
  , title: 'Nice Dream'
  , page: 'index'
  , description: 'Non-dairy coconut- and oat-milk ice creams and fresh fruit sorbets from Joshua Tree, CA.'
  , og_image: '/img/nice-dream-logo-og.png'
  , og_image_width: '1200'
  , og_image_height: '630'
  , collection_id: '69ddad9b449d6a56e2ff97e6'
  , stylesheet: '/css/index.css'
%}

<article class="page-content">
  <section class="page-region">
    <section data-theme="" class="page-section page-section--medium">
      <div class="page-section__border">
        <div class="page-section__background"></div>
      </div>
      <div class="page-section__wrapper" style="">
        <div class="page-section__content">
          <div class="grid-wrapper">
            <div class="grid home-grid">
              <div class="home-grid__photo">
                <div class="block image-block photo-block">
                  <div class="block__content">
                    <div class="image-block__frame">
                      <div class="image-block__figure" data-animate="image">
                        <div class="image-block__container">
                          <div class="image-block__media">
                            <div class="image-block__fill">
                              <img alt="" elementtiming="system-image-block" src="/img/DSC_4210.jpeg" width="3264" height="4928" alt="" sizes="auto, 100vw" style="display:block;object-position: var(--image-focal-point);object-fit: var(--image-object-fit);" srcset="/img/DSC_4210-100w.jpeg 100w, /img/DSC_4210-300w.jpeg 300w, /img/DSC_4210-500w.jpeg 500w, /img/DSC_4210-750w.jpeg 750w, /img/DSC_4210-1000w.jpeg 1000w, /img/DSC_4210-1500w.jpeg 1500w, /img/DSC_4210-2500w.jpeg 2500w" loading="lazy" decoding="async">

                              <div class="image-block__overlay"></div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="home-grid__details">
                <div class="block text-block">
                  <div class="block__content">
                    <div>
                      <div class="text-block__content">
                        <h4>{{ business.name }}</h4>
                        <p class="text-small">
                          {{ business.street_address }} {{ business.locality }}, {{ business.region }} {{ business.postal_code }}
                        </p>
                        {% for hours in business.hours %}
                        <p class="text-small">
                          {{ hours.label }} {% if hours.opens == "" %}CLOSED{% else %}{% include 'hours_time', time: hours.opens %}-{% include 'hours_time', time: hours.closes %}{% endif %}
                        </p>
                        {% endfor %}
                        <p class="text-small">
                          {{ business.hours_note }}
                        </p>
                        <p class="text-small">
                          {% if lunch.sample_menu %}
                          <span class="text-highlight"><a target="_blank" href="{{ lunch.sample_menu.url }}">Sample Menus</a
                            ></span
                          >
                          {% endif %}
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="home-grid__about">
                <div class="block text-block about-block">
                  <div class="block__content">
                    <div>
                      <div class="text-block__content">
                        {{ about.body }}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </section>
</article>
